{
  "name": "webapp",
  "version": "0.0.0",
  "private": true,
  "packageManager": "pnpm@11.20.0",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . && node scripts/lint-house-rules.mjs",
    "lint:house": "node scripts/lint-house-rules.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "check:contrast": "node scripts/check-contrast.mjs",
    "check:migrations": "node scripts/check-migrations.mjs",
    "check:drift": "node scripts/check-drift.mjs",
    "check:core": "node --env-file-if-exists=.env.local node_modules/tsx/dist/cli.mjs scripts/check-core.ts",
    "check:example": "node --env-file-if-exists=.env.local node_modules/tsx/dist/cli.mjs scripts/check-example.ts",
    "db:generate": "node --env-file-if-exists=.env.local node_modules/drizzle-kit/bin.cjs generate",
    "db:migrate": "node --env-file-if-exists=.env.local node_modules/tsx/dist/cli.mjs scripts/db-migrate.ts",
    "db:deploy": "node --env-file-if-exists=.env.local node_modules/tsx/dist/cli.mjs scripts/db-deploy.ts",
    "db:down": "node --env-file-if-exists=.env.local node_modules/tsx/dist/cli.mjs scripts/db-down.ts",
    "db:roundtrip": "node --env-file-if-exists=.env.local node_modules/tsx/dist/cli.mjs scripts/db-roundtrip.ts",
    "db:bootstrap": "node --env-file-if-exists=.env.local node_modules/tsx/dist/cli.mjs scripts/db-bootstrap.ts",
    "db:seed": "node --env-file-if-exists=.env.local node_modules/tsx/dist/cli.mjs scripts/db-seed.ts",
    "db:status": "node --env-file-if-exists=.env.local node_modules/tsx/dist/cli.mjs scripts/db-status.ts",
    "e2e": "node --env-file-if-exists=.env.local node_modules/@playwright/test/cli.js test",
    "e2e:ui": "node --env-file-if-exists=.env.local node_modules/@playwright/test/cli.js test --ui",
    "e2e:all": "node node_modules/next/dist/bin/next build && node --env-file-if-exists=.env.local node_modules/@playwright/test/cli.js test",
    "task:prune": "node --env-file-if-exists=.env.local node_modules/tsx/dist/cli.mjs scripts/task-prune.ts",
    "smoke:prod": "node node_modules/tsx/dist/cli.mjs scripts/smoke-prod.ts",
    "setup:hooks": "git config core.hooksPath .githooks",
    "template:schema": "node template/cli/bootstrap.mjs schema",
    "template:validate": "node template/cli/bootstrap.mjs validate",
    "template:generate": "node template/cli/bootstrap.mjs generate",
    "template:apply": "node template/cli/bootstrap.mjs apply",
    "template:status": "node template/cli/bootstrap.mjs status",
    "template:verify": "node template/cli/bootstrap.mjs verify",
    "template:adopt": "node template/cli/bootstrap.mjs adopt",
    "template:update": "node template/cli/bootstrap.mjs update",
    "template:add": "node template/cli/bootstrap.mjs add",
    "template:release": "node template/cli/bootstrap.mjs release",
    "entra:status": "node --env-file-if-exists=.env.local node_modules/tsx/dist/cli.mjs scripts/entra-status.ts",
    "doctor": "node --env-file-if-exists=.env.local node_modules/tsx/dist/cli.mjs scripts/doctor.ts",
    "check:secrets": "node node_modules/secretlint/bin/secretlint.js \"**/*\"",
    "check:all": "node --env-file-if-exists=.env.local node_modules/tsx/dist/cli.mjs scripts/check-all.ts",
    "check:grants": "node --env-file-if-exists=.env.local node_modules/tsx/dist/cli.mjs scripts/check-grants.ts",
    "db:app-login": "node --env-file-if-exists=.env.local node_modules/tsx/dist/cli.mjs scripts/db-app-login.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "0.131.0",
    "@neondatabase/serverless": "1.1.0",
    "drizzle-orm": "0.45.2",
    "next": "16.4.2",
    "next-auth": "5.0.0-beta.32",
    "nodemailer": "10.1.7",
    "qrcode": "1.5.4",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@secretlint/secretlint-rule-preset-recommend": "13.0.7",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "26.1.2",
    "@types/nodemailer": "8.0.2",
    "@types/qrcode": "1.5.6",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "drizzle-kit": "0.31.10",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.2",
    "secretlint": "13.0.7",
    "tailwindcss": "4.3.3",
    "tsx": "^4.23.7",
    "typescript": "6.0.3",
    "vitest": "^4.1.12"
  }
}
