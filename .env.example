# Kopieer naar .env.local en vul in. Nooit echte waarden in dit bestand: het staat in git.
# Hoe je aan elke waarde komt staat in docs/handleiding/06-variabelen-in-vercel.md.

# >>> template:core (beheerd blok, wordt bijgewerkt door pnpm template:update)
# Neon: de pooled string voor de app, de directe (unpooled) voor migraties en scripts.
# Lokaal wijzen allebei naar je dev-branch, nooit naar productie.
DATABASE_URL=
DATABASE_URL_UNPOOLED=

# Auth.js: een lange willekeurige waarde. Maak hem met:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
AUTH_SECRET=

# De omgeving: local op je laptop. In Vercel niet nodig (daar telt VERCEL_ENV); op een andere host
# production of preview. vercel env pull overschrijft dit bestand: zet APP_ENV daarna weer terug.
APP_ENV=local

# De dev-login, alleen lokaal: hij werkt alleen met APP_ENV=local en weigert anders te laden.
AUTH_DEV_LOGIN=1

# Het endpoint-id van de productiedatabase (zonder -pooler), zodat een preview-deploy weigert als
# hij per ongeluk op productie uitkomt. Alleen in Vercel nodig, zie docs/handleiding/04-neon.md.
PRODUCTION_DB_ENDPOINT=

# Het endpoint-id van de branch waar pnpm db:seed op mag schrijven. De seed weigert elke andere.
SEED_TARGET=

# De cronroutes weigeren alles zonder dit token; Vercel stuurt het mee bij elke cronaanroep.
# Maak hem met hetzelfde node-commando als AUTH_SECRET en zet hem in Vercel.
CRON_SECRET=
# <<< template:core

# >>> template:auth-entra (beheerd blok, wordt bijgewerkt door pnpm template:update)
# Microsoft Entra: de app-registratie van dit project. Zie docs/handleiding/05-entra.md.
AUTH_MICROSOFT_ENTRA_ID_ID=
AUTH_MICROSOFT_ENTRA_ID_SECRET=
# De issuer van de tenant: https://login.microsoftonline.com/<tenant-id>/v2.0
AUTH_MICROSOFT_ENTRA_ID_ISSUER=
# <<< template:auth-entra
